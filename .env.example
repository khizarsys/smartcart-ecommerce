# SmartCart is a static site with no build step, so the browser cannot read this file.
# These values are documentation for a future backend / build pipeline.
# The demo admin password currently lives in js/config.js and is intentionally public.

# Password for the admin panel in a real deployment (never commit the real value)
ADMIN_PASSWORD=change-me

# Base URL where the site is hosted
SITE_URL=https://your-username.github.io/smartcart-ecommerce/
